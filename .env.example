
# Set to true if you run into any installation issues
# Otherwise, keep false
APP_DEBUG=false
APP_ENV=production

# Application Timezone
# For list of possible timezones, please see https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=UTC

# APP_KEY will be replaced by install process - need a temp one or application will die
APP_KEY=base64:+qSMraSffH7P2pcc4WtxxwiLEkxIkGRO6lzdFGbthQA=
APP_URL=https://example.com

# DATABASE CONNECTION
DB_HOST=localhost
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret
DB_PREFIX=bss_

# currently, we only support mysql
DB_CONNECTION=mysql

# Redirects ALL requests to https. Off unless set.
# Requires the whole site to be served over HTTPS; if TLS is terminated by a
# proxy, set TRUSTED_PROXIES too. Without it the forwarded scheme is not
# believed, so those requests are served unredirected and a warning is logged.
REDIRECT_HTTPS=false

# Proxies whose X-Forwarded-* headers may be trusted. Comma separated IPs/CIDRs,
# or '*' to trust the immediate peer. Unset trusts nothing.
#TRUSTED_PROXIES=

# HARD CONFIG
CACHE_DRIVER=file
SESSION_DRIVER=file
# Session cookies follow REDIRECT_HTTPS unless set explicitly here.
# True requires the whole site to be served over HTTPS.
#SESSION_SECURE_COOKIE=true
QUEUE_DRIVER=sync
BROADCAST_DRIVER=null

# NOT USED
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379
