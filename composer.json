{
    "name": "aicwebtech/biblesupersearch-api",
    "description": "Bible SuperSearch API",
    "keywords": ["Bible", "API"],
    "license": "GPL-3.0-or-later",
    "type": "project",
    "homepage": "https://www.biblesupersearch.com",

    "require": {
        "php": ">=8.2.0",
        "laravel/framework": "^12.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "phpoffice/phpspreadsheet": "^5.0",
        "tecnickcom/tcpdf": "^6.2",
        "laravel/helpers": "^1.2",
        "laravel/tinker" : "^2.0",
        "laravel/ui" : "^4.0",
        "nunomaduro/collision" : "^8.1",
        "spatie/laravel-ignition": "^2.0",
        "sebastian/diff": "^6.0",
        "davechild/textstatistics": "1.*"
    },
    "require-dev": {
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^11.0",
        "filp/whoops": "~2.0",
        "brianium/paratest": "^7.0",
        "laravel/boost": "^2.4",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": [

        ],
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts-descriptions": {
        "test": "Run the full PHPUnit test suite.",
        "coverage": "Run the suite with code coverage; writes HTML to build/coverage/html and clover.xml for CI.",
        "coverage-text": "Run the suite with a text-only coverage summary printed to the terminal."
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-html build/coverage/html --coverage-clover build/coverage/clover.xml --coverage-text"
        ],
        "coverage-text": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text"
        ],
        "post-install-cmd": [
            "php artisan clear-compiled"
        ],
        "-pre-update-cmd": [
            "php artisan clear-compiled"
        ],
        "post-update-cmd": [

        ],
        "post-root-package-install": [
            "php -r \"copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    }
}
